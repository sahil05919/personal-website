+  return (
+    <article className="flex flex-col sm:grid sm:grid-cols-[180px_minmax(0,1fr)] sm:gap-x-[60px]">
+      <h2
+        id={entry.id}
+        className={`scroll-mt-24 font-serif-display ${heading} font-medium leading-[1.25] text-ink sm:col-start-2 sm:row-start-1`}
+      >
+        {entry.title}
+      </h2>
