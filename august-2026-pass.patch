+      <p className={`${META} mt-8 tracking-[0.02em] sm:mt-10`}>
+        {entry.attribution}
+      </p>
+    </div>
+  );
+
+  if (!hasStub) {
+    return (
+      <article className={plain ? "sm:pl-[240px]" : undefined}>
