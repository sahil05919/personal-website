+                  : 'mt-4 font-serif-display italic text-[1.375rem] md:text-[1.75rem] leading-[1.4] text-ink text-balance'
+              }
+            >
+              {line}
+            </motion.p>
+          ))}
+        </motion.div>
+      </div>
+    </section>
+  );
+}
