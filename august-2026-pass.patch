+          </div>
+        </LeafRow>
+
+        <LeafRow
+          className="mt-16 md:mt-20"
+          note={<MarginNote>recently</MarginNote>}
+        >
+          <ul className="m-0 flex max-w-[36rem] list-none flex-wrap p-0 font-mono text-[0.75rem] leading-[2] text-graphite">
+            {copy.index.map((place) => (
